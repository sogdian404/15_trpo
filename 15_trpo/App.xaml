<Application x:Class="_15_trpo.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:_15_trpo"
             xmlns:conv="clr-namespace:_15_trpo.CONV"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign2.Defaults.xaml"/>
                <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="Teal" SecondaryColor="LightGreen"/>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="MainBackgroundBrush" Color="#dfeaeb"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#00C4B4"/>
            <SolidColorBrush x:Key="HighlightBrush" Color="#00b4c4"/>
            <SolidColorBrush x:Key="LowStockBrush" Color="#ffd129"/>

            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignTextBox}">
                <Setter Property="AutomationProperties.Name" Value=""/>
            </Style>
            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignComboBox}">
                <Setter Property="AutomationProperties.Name" Value=""/>
            </Style>
            
            <Style TargetType="TabControl" BasedOn="{StaticResource MaterialDesignTabControl}">
                <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
            </Style>
            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource MainBackgroundBrush}"/>
            </Style>
            <conv:Stock x:Key="Stock"/>
        </ResourceDictionary>
    </Application.Resources>
</Application>
